<Window x:Class="WachModus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WachModus" Width="556" Height="499" MinWidth="496" MinHeight="439"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="11"
        Icon="Assets/WachModus.ico" Foreground="{DynamicResource Ink}" Background="{DynamicResource BackgroundBrush}">
  <Window.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F4F6FB"/>
    <SolidColorBrush x:Key="Panel" Color="White"/>
    <SolidColorBrush x:Key="Ink" Color="#131A2A"/>
    <SolidColorBrush x:Key="Muted" Color="#4B5872"/>
    <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentStrong" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="Line" Color="#D2DCEC"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder" CornerRadius="9" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.6"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="MetricLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Resources>
  <Grid x:Name="Viewport" SizeChanged="ResizeSurface" ClipToBounds="True" Background="{DynamicResource BackgroundBrush}">
    <Grid x:Name="Surface" Width="540" Height="460" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Grid.RenderTransform><ScaleTransform x:Name="SurfaceScale"/></Grid.RenderTransform>
      <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
          <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Width="34" HorizontalAlignment="Left">
            <TextBlock Text="☕" Foreground="{DynamicResource Accent}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1"><TextBlock Text="WachModus" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="Dein PC. In deinem Rhythmus." Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel>
          <Border Grid.Column="2" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" VerticalAlignment="Center" Margin="0,0,9,0" Padding="7,3">
            <TextBlock Text="2.2" Foreground="{DynamicResource Muted}" FontFamily="Consolas" FontSize="10"/>
          </Border>
          <Button x:Name="SettingsButton" Grid.Column="3" Content="⚙" FontSize="18" BorderThickness="0" Background="Transparent"
                  Click="OpenSettings" ToolTip="Einstellungen" AutomationProperties.Name="Einstellungen"/>
        </Grid>
        <Border Grid.Row="1" CornerRadius="18" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,14,0,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <Border Background="{DynamicResource AccentSoft}" CornerRadius="12" Padding="9,4" HorizontalAlignment="Left">
                  <TextBlock x:Name="StateLabel" Text="●  Wachmodus aktiv" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                </Border>
                <TextBlock x:Name="Headline" Text="Dein PC&#10;bleibt wach." FontSize="27" FontWeight="SemiBold" Margin="0,10,0,8"/>
                <TextBlock x:Name="Description" Text="Für Downloads, Präsentationen&#10;und alles, was noch Zeit braucht." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
              </StackPanel>
              <Grid Grid.Column="1" Width="128" Height="128" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                <Ellipse Stroke="{DynamicResource Line}" StrokeDashArray="2,5" Margin="2"/>
                <Ellipse Stroke="{DynamicResource AccentSoft}" Margin="14"/>
                <Path x:Name="ProgressArc" Stroke="{DynamicResource Accent}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock x:Name="CoffeeGlyph" Text="☕" FontSize="34" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="OrbitLabel" Text="ALLES WACH" Foreground="{DynamicResource Muted}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
              </Grid>
            </Grid>
            <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,12">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="AKTIVE ZEIT" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="ElapsedLabel" Style="{StaticResource MetricValue}" Text="00:00:00"/></StackPanel>
                <Border Grid.Column="1" BorderThickness="1,0" BorderBrush="{DynamicResource Line}" Padding="12,0">
                  <StackPanel><TextBlock x:Name="RemainingHeading" Text="LAUFZEIT" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="RemainingLabel" Style="{StaticResource MetricValue}" Text="Unbegrenzt"/></StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock Text="SYSTEMSIGNAL" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="PulseLabel" Style="{StaticResource MetricValue}" Text="Gerade eben"/></StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
          <DockPanel Margin="0,0,0,8"><TextBlock Text="Wie lange darf’s sein?" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock Text="Timer beginnt ab Auswahl" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
          <UniformGrid Rows="1" Height="32">
            <Button x:Name="UnlimitedButton" Content="∞ Unbegrenzt" Tag="0" Click="ChooseDuration" Margin="0,0,3,0"/>
            <Button x:Name="HalfHourButton" Content="30 Minuten" Tag="1800" Click="ChooseDuration" Margin="3,0"/>
            <Button x:Name="HourButton" Content="1 Stunde" Tag="3600" Click="ChooseDuration" Margin="3,0"/>
            <Button x:Name="TwoHoursButton" Content="2 Stunden" Tag="7200" Click="ChooseDuration" Margin="3,0,0,0"/>
          </UniformGrid>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
          <TextBlock x:Name="ErrorLabel" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#C2410C" Margin="0,0,0,8"/>
          <Grid Height="38"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
            <Button x:Name="ToggleButton" Content="Ⅱ  Pausieren" Background="{DynamicResource AccentStrong}" Foreground="White"
                    BorderThickness="0" FontSize="13" FontWeight="SemiBold" Click="ToggleSession" ToolTip="Pausieren / Fortsetzen (Strg+P)"/>
            <Button x:Name="ResetButton" Grid.Column="1" Content="↻" FontSize="21" Margin="8,0,0,0" Click="ResetSession"
                    ToolTip="Sitzung stoppen und zurücksetzen (Strg+R)" AutomationProperties.Name="Sitzung zurücksetzen"/>
          </Grid>
        </StackPanel>
        <DockPanel Grid.Row="4" Margin="0,14,0,0" Height="13">
          <TextBlock Text="Auch im Infobereich" Foreground="{DynamicResource Muted}" FontSize="10"/>
          <TextBlock Text="Schließen beendet den Wachmodus" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right"/>
        </DockPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
